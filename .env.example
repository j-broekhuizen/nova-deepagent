# Nova - Environment Variables
# Copy this to .env and fill in your values

# Anthropic API Key (required)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Model (used for all agents)
MODEL=anthropic:claude-haiku-4-5-20251001

# LangSmith Tracing (optional but recommended)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=nova
LANGSMITH_TRACING=true

# Context Hub
NOVA_CONTEXT_HUB_AGENT=nova
NOVA_CONTEXT_HUB_WORKSPACE=your-workspace-id

# LangSmith Project for DeepAgents
DEEPAGENTS_LANGSMITH_PROJECT=nova-copilot
